# Ollama Local Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embeddings are in-process ONNX (MODEL_PROFILE below picks the model). The Ollama embedding path was removed:
# a leftover EMBEDDING_PROVIDER=ollama now fails with instructions; unset it and re-index (make sync FORCE=1).

# PostgreSQL checkpoint store (docker-compose.yml reads these; there is no default password).
# 'make up' creates .env with a random POSTGRES_PASSWORD if it does not exist. Existing volume from an earlier
# version? Run 'make db-password' once. The server listens on 127.0.0.1 only.
POSTGRES_USER=rag_user
POSTGRES_DB=rag_checkpoints
# POSTGRES_PASSWORD=<a long random value; never commit it>
# POSTGRES_PORT=5432
# Use that server as the checkpoint store (the app expands ${...} from this file). SQLite is the default.
# DB_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Connections the UI server keeps open in its one shared pool (raise for many concurrent users)
# CHECKPOINT_POOL_SIZE=5
# Run the PostgreSQL checkpointer tests against another server (CI sets it and REQUIRE_POSTGRES=1)
# POSTGRES_TEST_URI=postgresql://user:password@host:5432/database

# `make recover` is the operator break-glass for a locked-out account (lost authenticator, forgotten password),
# including a sole owner. It needs no sign-in, so switch it off on a shared host: LOCAL_RECOVERY=off
# LOCAL_RECOVERY=on

# A second place for audit anchors (another disk, a mounted share, a synced folder). 'make audit-anchor' writes
# every anchor to both, 'make audit-verify' checks both and compares them, so rewinding or deleting the anchor
# file on this host is detected. It must be somewhere an attacker on this host cannot rewrite.
# AUDIT_ANCHOR_COPY_DIR=/Volumes/Backup/rag-anchors

# Storage Directories
CHROMA_PATH=./chroma_data
BM25_DIR=./bm25_indices
UPLOADS_DIR=./uploads

# Self-RAG retry budgets (query rewrites / regenerations with grader feedback)
# MAX_RETRIEVAL_RETRIES=2
# MAX_GENERATION_RETRIES=1

# Candidate retrieval widths
# RETRIEVAL_DENSE_K=5
# RETRIEVAL_SPARSE_K=5
# RETRIEVAL_FUSION_TOP_N=8
# RETRIEVAL_RERANK_TOP_K=3

# Models and languages: multilingual (default), multilingual-large, or en. Changing it: make models, then re-sync.
# MODEL_PROFILE=multilingual
# Keyword index tokenizer: trigram (default), unicode61, porter. Changing it re-indexes on the next sync.
# SPARSE_TOKENIZER=trigram

# Key storage for the access and data keys: auto (default: the OS keychain when one is usable, otherwise
# owner-only key files), file, or keyring (required). Existing key files stay files until `make migrate-keys`.
# `make backup` excludes keys: keep a copy of a keychain-held key in custody (`make migrate-keys REVERSE=1`).
# KEY_STORE=auto
# KEY_SERVICE=local-rag-lab

# The native Rust accelerator (rag_accel): preferred (default) uses it and falls back, loudly, to pure Python when it
# is missing; required refuses to start without it. 'make setup' installs it (wheelhouse/, then cargo).
# RAG_ACCEL=preferred

# --- Scaling options, all off by default (docs/scaling.md) --------------------------------------------------------
# Where chunk vectors live: chroma (embedded, default), qdrant or pgvector. Switching needs a re-sync:
# make sync ADMIN=<admin> FORCE=1. Start a server with: make scale-up SERVICE=qdrant (or pgvector).
# VECTOR_STORE=chroma
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # empty = no authentication (loopback only); set one before exposing the port
# QDRANT_PREFIX=             # prepended to collection names so installs can share a server
# PGVECTOR_URI=              # default: built from POSTGRES_* for the compose profile (port 5433)
# PGVECTOR_SCHEMA=public

# The semantic cache: sqlite (default) or postgres, shared by several UI processes. All of them need the same data key.
# CACHE_BACKEND=sqlite
# CACHE_DB_URI=postgresql://user:password@host:5432/dbname

# A chat model on vLLM, LM Studio or llama.cpp: LLM_PROVIDER=openai
# LOCAL_LLM_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-8B
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TEMPLATE_KWARGS={"enable_thinking": false}   # empty = send none (a server that rejects unknown fields)
# VLLM_MODEL=Qwen/Qwen3-8B   # for `make scale-up SERVICE=vllm` (needs an NVIDIA GPU); VLLM_API_KEY, VLLM_PORT
