# Ollama Local Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embeddings: fastembed (default, in-process ONNX) or ollama (uses OLLAMA_EMBED_MODEL).
# Changing the provider requires a re-index: make sync ADMIN=<admin> FORCE=1
# EMBEDDING_PROVIDER=fastembed
# OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL checkpoint store (docker-compose.yml reads these; there is no default password).
# 'make up' creates .env with a random POSTGRES_PASSWORD if it does not exist. Existing volume from an earlier
# version? Run 'make db-password' once. The server listens on 127.0.0.1 only.
POSTGRES_USER=rag_user
POSTGRES_DB=rag_checkpoints
# POSTGRES_PASSWORD=<a long random value; never commit it>
# POSTGRES_PORT=5432
# Use that server as the checkpoint store (the app expands ${...} from this file). SQLite is the default.
# DB_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Connections the UI server keeps open in its one shared pool (raise for many concurrent users)
# CHECKPOINT_POOL_SIZE=5
# Run the PostgreSQL checkpointer tests against another server (CI sets it and REQUIRE_POSTGRES=1)
# POSTGRES_TEST_URI=postgresql://user:password@host:5432/database

# A second place for audit anchors (another disk, a mounted share, a synced folder). 'make audit-anchor' writes
# every anchor to both, 'make audit-verify' checks both and compares them, so rewinding or deleting the anchor
# file on this host is detected. It must be somewhere an attacker on this host cannot rewrite.
# AUDIT_ANCHOR_COPY_DIR=/Volumes/Backup/rag-anchors

# Storage Directories
CHROMA_PATH=./chroma_data
BM25_DIR=./bm25_indices
UPLOADS_DIR=./uploads

# Self-RAG retry budgets (query rewrites / regenerations with grader feedback)
# MAX_RETRIEVAL_RETRIES=2
# MAX_GENERATION_RETRIES=1

# Models and languages: multilingual (default), multilingual-large, or en. Changing it: make models, then re-sync.
# MODEL_PROFILE=multilingual
# Keyword index tokenizer: trigram (default), unicode61, porter. Changing it re-indexes on the next sync.
# SPARSE_TOKENIZER=trigram

# Key storage for the access and data keys: auto (default: the OS keychain when one is usable, otherwise
# owner-only key files), file, or keyring (required). Existing key files stay files until `make migrate-keys`.
# `make backup` excludes keys: keep a copy of a keychain-held key in custody (`make migrate-keys REVERSE=1`).
# KEY_STORE=auto
# KEY_SERVICE=local-rag-lab
