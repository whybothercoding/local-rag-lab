---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	guardrail(guardrail)
	cache_lookup(cache_lookup)
	router(router)
	chitchat(chitchat)
	retrieve(retrieve)
	grade_docs(grade_docs)
	rewrite(rewrite)
	generate(generate)
	grade_hallucination(grade_hallucination)
	grade_relevance(grade_relevance)
	human_approval(human_approval)
	__end__([<p>__end__</p>]):::last
	__start__ --> guardrail;
	cache_lookup -. &nbsp;hit&nbsp; .-> __end__;
	cache_lookup -. &nbsp;miss&nbsp; .-> router;
	generate --> grade_hallucination;
	grade_docs -. &nbsp;approved&nbsp; .-> generate;
	grade_docs -.-> rewrite;
	grade_hallucination -. &nbsp;retry&nbsp; .-> generate;
	grade_hallucination -. &nbsp;grounded&nbsp; .-> grade_relevance;
	grade_hallucination -. &nbsp;circuit_break&nbsp; .-> human_approval;
	grade_relevance -. &nbsp;circuit_break&nbsp; .-> human_approval;
	grade_relevance -. &nbsp;irrelevant&nbsp; .-> rewrite;
	guardrail -. &nbsp;fail&nbsp; .-> __end__;
	guardrail -. &nbsp;pass&nbsp; .-> cache_lookup;
	retrieve --> grade_docs;
	rewrite --> retrieve;
	router -.-> chitchat;
	router -. &nbsp;rag&nbsp; .-> retrieve;
	chitchat --> __end__;
	human_approval --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
